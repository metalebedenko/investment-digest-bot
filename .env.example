# Investment Digest Bot
# Скопируй этот файл в .env и заполни значения

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Search / fallback providers
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# Optional keys for custom models configured from the panel
SEARCH_MODEL_API_KEY=
WRITER_MODEL_API_KEY=

# Digest defaults
IDEAS_COUNT_MIN=5
IDEAS_COUNT_MAX=10
